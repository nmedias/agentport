{
  "name": "agentport-monorepo",
  "private": true,
  "workspaces": [
    "libs/*"
  ],
  "scripts": {
    "postinstall": "playwright install chromium",
    "storybook": "nx storybook @agentport/ui --port 6006",
    "build-storybook": "nx build-storybook @agentport/ui",
    "test": "nx run-many -t test",
    "test:unit": "vitest run --project @agentport/ui --config libs/ui/vite.config.mts",
    "test:stories": "vitest run --project storybook --config libs/ui/vite.config.mts",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t lint test typecheck",
    "shoot": "node tools/shoot-stories.mjs",
    "ui:add": "npx shadcn@latest add -c libs/ui",
    "graph": "nx graph",
    "sync": "nx sync",
    "reset": "nx reset"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/react": "^22.7.5",
    "@nx/storybook": "^22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/vitest": "22.7.5",
    "@nx/web": "22.7.5",
    "@storybook/addon-a11y": "10.4.4",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "10.4.4",
    "@storybook/react-vite": "10.4.2",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "ajv": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "^22.7.5",
    "playwright": "^1.61.0",
    "shadcn": "^4.10.0",
    "storybook": "^10.4.4",
    "storybook-addon-pseudo-states": "^10.4.2",
    "tailwindcss": "^4.3.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.40.0",
